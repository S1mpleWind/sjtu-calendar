{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SJTU Schedule",
  "version": "1.1.2",
  "identifier": "edu.sjtu.schedule",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SJTU Schedule",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "visible": false
      },
      {
        "label": "widget",
        "title": "SJTU Schedule Widget",
        "url": "index.html?window=widget",
        "width": 320,
        "height": 420,
        "minWidth": 280,
        "minHeight": 340,
        "maxWidth": 560,
        "maxHeight": 760,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "noRedirectionBitmap": true,
        "windowEffects": { "effects": ["acrylic"] },
        "visible": true,
        "skipTaskbar": true,
        "alwaysOnTop": false,
        "create": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1421",
        "font-src": "'self' data:",
        "img-src": "'self' asset: http://asset.localhost data:",
        "style-src": "'self' 'unsafe-inline'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
